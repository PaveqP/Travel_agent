# Новый клон: cp .env.example .env, затем заполните четыре обязательных поля.
# Существующий .env не перезаписывайте. Значения секретов в Git не добавляйте.

# Обязательно: OpenAI-совместимый API с tool calling и structured output.
MODEL=
TOKEN=
BASE_URL=

# Обязательно: придумайте пароль для новой PostgreSQL.
# Если volume уже существует, используйте его прежний пароль.
TRAVEL_POSTGRES_PASSWORD=

# Необязательно: сайт работает и без Telegram.
TELEGRAM_BOT_TOKEN=
# По умолчанию в Compose: http://127.0.0.1:8080.
TRAVEL_PUBLIC_URL=

# Необязательно: порт PostgreSQL на хосте; измените при конфликте порта.
# По умолчанию: 55432.
TRAVEL_POSTGRES_PORT=

# Дополнительные источники runtime. Туту MCP и Open-Meteo не требуют ключа.
# Без ключа соответствующий источник недоступен; цены не подменяются fixtures.
# Tavily даёт контекст, а не подтверждённые котировки.
TAVILY_API_KEY=
YANDEX_RASP_API_KEY=
TRAVELPAYOUTS_TOKEN=
TWOGIS_API_KEY=
GEOAPIFY_API_KEY=
TIMEPAD_TOKEN=
OPENTRIPMAP_API_KEY=

# Только для разработки и внешних API-клиентов, не нужны для Compose.
# Несколько Bearer-токенов разделяются запятыми, один на пользователя.
TRAVEL_API_TOKEN=
# PostgreSQL для запуска с хоста. Compose сам задаёт внутренний адрес БД.
TRAVEL_DATABASE_URL=

# Существующие настройки из передаваемой конфигурации.
# Партнёрский marker из кабинета Travelpayouts; исследовательские ссылки.
TRAVELPAYOUTS_MARKER=
# Sandbox-ключ LiteAPI: https://dashboard.liteapi.travel/ (исследовательский адаптер).
LITEAPI_API_KEY=
# OpenRouteService: https://account.heigit.org/ (исследовательский адаптер).
ORS_API_KEY=
# Совместимое имя ключа Tavily: https://app.tavily.com/.
# Приложение использует его, если TAVILY_API_KEY не заполнен.
TAVILY=

# Доступ к дополнительным источникам описан в docs/API_KEYS_SETUP.md.
# Исследовательские адаптеры не нужны для запуска приложения.
# Наличие ключа не разрешает live smoke.
