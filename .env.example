# Для нового клона: cp .env.example .env и заполните обязательные поля ниже.
# Если .env уже есть, дополните его вручную и сохраните прежние значения.
# MODEL, TOKEN, BASE_URL — реальные имена существующей LLM-конфигурации.
# Значения намеренно не скопированы. Сохраните уже настроенные значения.
MODEL=
TOKEN=
BASE_URL=

# Веб и Telegram: общая PostgreSQL, секрет бота только на сервере.
# Docker Compose: заполните вместе с MODEL, TOKEN, BASE_URL и запустите docker compose up.
# Для существующего volume укажите прежний пароль PostgreSQL.
TRAVEL_POSTGRES_PASSWORD=
TELEGRAM_BOT_TOKEN=
TRAVEL_PUBLIC_URL=http://127.0.0.1:8080
# Порт PostgreSQL на хосте; измените, если 55432 уже занят.
TRAVEL_POSTGRES_PORT=55432

# Ниже — ключи runtime и исследовательских адаптеров. Полный список не обязателен.
# Заполненный ключ НЕ разрешает расход платных квот или реальные бронирования.
# Не нужны все ключи сразу: приоритетный список — docs/API_KEYS_SETUP.md.

# Aviasales / Travelpayouts Data API — P1; self_service
# https://www.travelpayouts.com/developers/api
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Duffel Flights — P3; self_service
# https://app.duffel.com/join
# Только test token; live не включать.
DUFFEL_ACCESS_TOKEN=

# Aviationstack — P2; self_service
# https://aviationstack.com/signup/free
AVIATIONSTACK_API_KEY=

# AirLabs — P2; self_service
# https://airlabs.co/signup
AIRLABS_API_KEY=

# Островок / Emerging Travel Group — P0; partner
# https://ostrovok.ru/affiliate/
# Только выданный для sandbox/test endpoint; не угадывать production URL.
ETG_KEY_ID=
ETG_API_KEY=
ETG_BASE_URL=

# Nuitee Connect / LiteAPI — P1; self_service
# https://dashboard.liteapi.travel/
# Sandbox sand_ key; до запросов проверить бесплатность endpoints.
LITEAPI_API_KEY=

# Booking.com Demand API — P3; partner
# https://developers.booking.com/demand/docs
BOOKING_API_KEY=
BOOKING_AFFILIATE_ID=

# Expedia Rapid — P3; partner
# https://partner.expediagroup.com/en-us/solutions/build-your-travel-experience/rapid-api
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=

# Hotelbeds / HBX — P3; self_service
# https://developer.hotelbeds.com/
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=

# Яндекс Расписания — P0; self_service
# https://developer.tech.yandex.ru/
YANDEX_RASP_API_KEY=

# 2ГИС — P0; self_service
# https://platform.2gis.ru/
TWOGIS_API_KEY=

# Google Maps / Maps Grounding Lite — P2; self_service
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Mapbox — P2; self_service
# https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=

# OpenRouteService / HeiGIT — P1; self_service
# https://account.heigit.org/
ORS_API_KEY=

# GraphHopper — P2; self_service
# https://graphhopper.com/dashboard/#/signup
GRAPHHOPPER_API_KEY=

# Geoapify — P1; self_service
# https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# GeoNames — P2; self_service
# https://www.geonames.org/login
GEONAMES_USERNAME=

# Timepad — P1; self_service
# https://timepad.ru/
TIMEPAD_TOKEN=

# OpenTripMap — P1; self_service
# https://dev.opentripmap.org/price
OPENTRIPMAP_API_KEY=

# Sputnik8 — P1; partner
# https://www.sputnik8.com/ru/affiliate/new
SPUTNIK_API_KEY=
SPUTNIK_USERNAME=

# Tripster affiliate API — P1; partner
# https://experience.tripster.ru/partner/
# Только ID; схему авторизации дополнить по документации партнёрского кабинета.
TRIPSTER_PARTNER_ID=

# Viator Partner API — P3; partner
# https://partnerresources.viator.com/
VIATOR_API_KEY=

# Qtickets — P3; self_service
# https://qtickets.ru/
# Только если есть роль организатора; не ключ публичного поиска по всему Сочи.
QTICKETS_TOKEN=

# PRO.Культура.РФ export API — P1; partner
# https://pro.culture.ru/
CULTURE_API_KEY=

# WeatherAPI — P2; self_service
# https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=

# OpenWeather REST / MCP for agents — P2; self_service
# https://home.openweathermap.org/users/sign_up
# REST key; НЕ credentials отдельного MCP for agents. One Call не активировать автоматически.
OPENWEATHER_API_KEY=

# Туту, OSM/Overpass/Nominatim, KudaGo, Open-Meteo, Wikidata, ЦБ: ключи для
# описанного исследовательского доступа не нужны. Go deeplink ключ не требует.
# MixVel, Сирена, Броневик, UFS, Kiwitaxi, Intui, GYG: сначала получить условия
# и схему credentials у партнёрского менеджера, не выдумывать поля.
# Amadeus: актуальный self-service доступ не подтверждён, ключ пока не нужен.
# Open-Meteo commercial key в исследовании не требуется; подписку не покупаем.

# Backend: optional Tavily context; never used as a live quote.
TAVILY_API_KEY=
# Comma-separated bearer tokens, one token per demo user. Generate locally.
TRAVEL_API_TOKEN=
# Direct host startup only. Compose constructs its internal URL using service postgres.
TRAVEL_DATABASE_URL=
